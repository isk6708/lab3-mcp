# Copy this file to .env and fill in your values. .env is ignored by git.

# Which LLM answers the server's sampling requests: github | openai | ollama
LLM_PROVIDER=github

# github: GitHub Models token with "Models: read"
GITHUB_TOKEN=github_pat_your_token_here

# openai: OpenAI / ChatGPT API key (paid)
# OPENAI_API_KEY=sk-your_key_here

# ollama: local, free, no key (ollama pull llama3.2)
# OLLAMA_HOST=http://localhost:11434

# Optional model override. Defaults:
#   github: openai/gpt-4o-mini   openai: gpt-4o-mini   ollama: llama3.2
# MODEL_NAME=qwen2.5
