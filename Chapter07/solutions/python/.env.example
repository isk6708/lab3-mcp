# Copy this file to .env and fill in your values.
# .env is ignored by git (see .gitignore) - never commit your real keys.

# Which LLM to use: github | openai | ollama
LLM_PROVIDER=github

# --- github: GitHub Models (free tier) -------------------------------------
# Personal access token with the "Models: read" permission
GITHUB_TOKEN=github_pat_your_token_here

# --- openai: OpenAI / ChatGPT API (paid) -----------------------------------
# Key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your_key_here

# --- ollama: local models, free, no key ------------------------------------
# Install from https://ollama.com, then e.g.:  ollama pull llama3.2
# OLLAMA_HOST=http://localhost:11434

# --- Optional: override the model (defaults per provider) -------------------
#   github: openai/gpt-4o     openai: gpt-4o-mini     ollama: llama3.2
# MODEL_NAME=qwen2.5
# MODEL_ENDPOINT=   (only to use a different OpenAI-compatible URL)
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_MAX_TOKENS=500
